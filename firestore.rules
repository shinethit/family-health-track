rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        isSignedIn() && (
          request.auth.token.email == 'shinethitsmt@gmail.com' ||
          request.auth.token.email == 'shinethit.smt@gmail.com' ||
          request.auth.token.email == 'admin@familyhealthtrack.com' ||
          request.auth.token.admin == true ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        )
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /vitals/{vitalId} {
      allow read, write: if true;
    }

    match /glucose/{gluId} {
      allow read, write: if true;
    }

    match /bmi/{bmiId} {
      allow read, write: if true;
    }

    match /labTests/{testId} {
      allow read, write: if true;
    }

    match /medications/{medId} {
      allow read, write: if true;
    }

    match /doctorAdvices/{adviceId} {
      allow read, write: if true;
    }

    match /doctorQuestions/{questionId} {
      allow read, write: if true;
    }
  }
}
