rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unmatched collections & documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin verified strictly via presence in the /admins/{uid} collection
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || request.resource.data.role != 'admin'
      );
      allow update: if (
        isOwner(userId) && (
          !('role' in request.resource.data) || 
          request.resource.data.role != 'admin' ||
          (resource != null && 'role' in resource.data && request.resource.data.role == resource.data.role)
        )
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Helper for standard user-owned records
    function isValidUserRecord() {
      return (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }
    
    function canCreateUserRecord() {
      return (isSignedIn() && request.resource.data.userId == request.auth.uid) || (isAdmin() && request.resource.data.userId is string);
    }

    function canUpdateUserRecord() {
      return (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin();
    }

    // Patient Health Records
    match /vitals/{vitalId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /glucose/{gluId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /bmi/{bmiId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /labTests/{testId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /medications/{medId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /familyMembers/{memberId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /medicationLogs/{logId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    match /vaccines/{vacId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    // ---------------------------------------------------------
    // 🔴 အသစ်ထပ်တိုးထားသော Rules များ (Signup အတွက် အရေးကြီးသည်)
    // ---------------------------------------------------------

    // Notifications (အကောင့်ဖွင့်တာနဲ့ ကြိုဆိုတဲ့ Notification ဝင်လာတာမျိုးအတွက်)
    match /notifications/{notificationId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    // Custom Reminders (သတိပေးချက်များ သိမ်းဆည်းရန်)
    match /customReminders/{reminderId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    // Emergency Profiles (အရေးပေါ် ID အတွက်)
    match /emergencyProfiles/{profileId} {
      allow read: if isValidUserRecord();
      allow create: if canCreateUserRecord();
      allow update: if canUpdateUserRecord();
      allow delete: if isValidUserRecord();
    }

    // ---------------------------------------------------------

    // Doctor Advices
    match /doctorAdvices/{adviceId} {
      allow read: if isValidUserRecord();
      allow create, update: if isAdmin();
      allow delete: if isValidUserRecord();
    }

    // Doctor Questions
    match /doctorQuestions/{questionId} {
      allow read: if isValidUserRecord();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == resource.data.userId &&
        (!('doctorAnswer' in request.resource.data) || request.resource.data.doctorAnswer == resource.data.doctorAnswer)
      );
      allow delete: if isValidUserRecord();
    }

    // Broadcast Tickers
    match /broadcastTickers/{tickerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}